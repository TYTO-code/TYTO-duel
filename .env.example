# Porta HTTP (o frontend aponta VITE_DUEL_API_URL para este serviço; padrão 3002,
# para não colidir com a TYTO.club-API em 3001)
PORT=3002

# Credenciais do firebase-admin — use UMA das opções abaixo:
# 1) caminho para o JSON da service account (Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# 2) o JSON da service account inteiro numa variável (útil em deploy)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Opcional: origens permitidas pelo CORS, separadas por vírgula (padrão: todas)
# CORS_ORIGIN=http://localhost:5173,https://tyto.club
